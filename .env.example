# =============================================================================
# CommitPost — variáveis de ambiente
# =============================================================================
# Copie para .env.local (git-ignored) para rodar localmente.
#
# Onde cada variável precisa existir em produção:
#   [A] GitHub Secrets  → consumidas por apps/pipeline no runner do Actions
#   [V] Vercel Env Vars → consumidas por apps/web (webhook, painel, OAuth)
#   [AV] ambos
#
# NÃO existe CRON_SECRET: o pipeline roda dentro do runner do Actions,
# não há endpoint HTTP de disparo para autenticar.
# =============================================================================

# --- Banco (Neon) ------------------------------------------------------------
# [AV] Connection string do Neon. Use a variante -pooler para o app web.
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/commitpost?sslmode=require

# --- GitHub (coleta de commits) ----------------------------------------------
# [A] PAT com leitura de repositórios. Se algum repo estiver numa org com SAML
#     SSO, o token precisa ser explicitamente autorizado para aquela org.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [A] Lista de e-mails de autor, separados por vírgula. Commits de trabalho
#     costumam estar sob um e-mail diferente do pessoal — inclua todos.
GITHUB_AUTHOR_EMAILS=voce@pessoal.com,voce@empresa.com

# [A] Janela de varredura, em dias. Deve casar com o cron do scan.yml.
GITHUB_LOOKBACK_DAYS=7

# --- Filtro de confidencialidade -------------------------------------------
# [A] Nomes de empresas, clientes, produtos internos e os NOMES REAIS dos
#     repositórios, separados por vírgula. O filtro remove tudo isso.
#
#     ATENÇÃO: esta lista nomeia exatamente aquilo que não pode vazar, então
#     ela é tão confidencial quanto o conteúdo. NUNCA commitar — o repositório
#     é público. Só em .env.local e GitHub Secrets.
REDACT_DENIED_TERMS=

# --- Claude (geração dos posts) ----------------------------------------------
# [A] Chave da API da Anthropic. Modelo usado: claude-opus-5.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Telegram (aprovação) ----------------------------------------------------
# [AV] Token do bot, obtido via @BotFather.
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [A] Chat do OPERADOR, para avisos de sistema. Não é mais a allowlist: com
#     vários devs, quem pode aprovar um post é qualquer chat vinculado a um
#     usuário ativo em users.telegram_chat_id, e o vínculo se faz sozinho pelo
#     link t.me/<bot>?start=<código> da tela de introdução.
TELEGRAM_CHAT_ID=123456789

# [V] Secret enviado pelo Telegram no header X-Telegram-Bot-Api-Secret-Token.
#     Gere com: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# --- Acesso ------------------------------------------------------------------
# [V] Logins do GitHub autorizados a entrar, separados por vírgula.
#     O login é feito com GitHub; sem esta lista qualquer pessoa entraria.
#     Quem não está aqui recebe recusa seca e nada é gravado no banco.
ALLOWED_GITHUB_LOGINS=eduardoehg

# --- GitHub App (Fase 1.5) ---------------------------------------------------
# [AV] Substitui o GITHUB_TOKEN pessoal. Cada dev instala o app na conta dele;
#      os tokens de acesso são gerados na hora e expiram em 1h, então nenhuma
#      credencial de dev fica armazenada.
#
#      ATENÇÃO ao copiar: APP_ID é o número em "App ID"; CLIENT_ID é o valor
#      que começa com "Iv23". Ficam lado a lado na mesma tela e são trocados o
#      tempo todo — o schema recusa letra em GITHUB_APP_ID por causa disso.
GITHUB_APP_ID=
# O slug da URL do app: github.com/apps/<slug>. Usado no botão de instalação.
GITHUB_APP_SLUG=commit-post
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# A chave privada .pem em base64, numa linha: base64 -w0 app.private-key.pem
GITHUB_APP_PRIVATE_KEY=

# --- Cifra de tokens ---------------------------------------------------------
# [AV] Chave de 32 bytes em hex para cifrar tokens de terceiros no banco.
#      Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
#      Trocar esta chave torna ilegível tudo que já foi cifrado com a antiga:
#      na prática, todo dev precisa reautorizar GitHub e LinkedIn.
TOKEN_ENCRYPTION_KEY=

# --- OAuth App clássico (Fase 1.5) -------------------------------------------
# [V] Separado do GitHub App, e opcional.
#     A instalação de um GitHub App só enxerga repositórios da conta onde foi
#     instalada. Para repos onde o dev é apenas COLABORADOR, é preciso um
#     token que aja como ele — e o OAuth clássico é o único caminho.
#
#     Custo: o escopo `repo` é leitura E escrita. Não existe escopo somente
#     leitura para repositório privado no OAuth clássico. Por isso a concessão
#     é opt-in por dev, e o token vai cifrado para o banco.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Painel web (edição) -----------------------------------------------------
# [V] Segredo usado para assinar (HMAC) os links de edição enviados no Telegram.
#     O painel não tem login: o link assinado É a autenticação.
#     Gere com: openssl rand -hex 32
PANEL_TOKEN_SECRET=

# [AV] URL base pública do app. Usada para montar os links do painel e o
#      redirect_uri do OAuth. Em dev: http://localhost:3000
APP_BASE_URL=https://commitpost.vercel.app

# --- LinkedIn (publicação — Fase 7) ------------------------------------------
# [V] Credenciais do app no LinkedIn Developer Portal.
#     Escopos necessários: w_member_social openid profile
#     (openid/profile são obrigatórios para obter o URN do autor via /v2/userinfo)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# [V] Deve bater EXATAMENTE com o registrado no portal do LinkedIn.
LINKEDIN_REDIRECT_URI=https://commitpost.vercel.app/api/auth/linkedin/callback

# NOTA: não existe LINKEDIN_ACCESS_TOKEN aqui de propósito. O token de membro
# expira em ~60 dias; ele é persistido no banco com expires_at e renovado pelo
# fluxo OAuth, não fixado em env var (que quebraria silenciosamente).
